# Copie para .env.local e preencha. Nunca versione .env.local.

# URL pública do site, sem barra no final (usada em SEO, sitemap e Open Graph). Ex.: https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=

# Número do WhatsApp da loja no formato 55DDDNÚMERO, só dígitos. Ex.: 5511900000000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Perfil da OverSoul no Instagram (link completo).
NEXT_PUBLIC_INSTAGRAM_URL=

# Site "Vestindo seu Ministério" (link completo). Vazio = link some do rodapé.
NEXT_PUBLIC_MINISTRY_URL=
